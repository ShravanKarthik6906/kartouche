# Copy this file to .env and fill in what you need. Commented-out lines show defaults. .env is gitignored - never commit it.
# Every setting is optional except OPENAI_API_KEY (needed to translate your own files).

# --- Translation -------------------------------------------------------------

# Your OpenAI API key. Translation and the shorten-to-fit step make real,
# billed calls with it. Also set a monthly budget in the OpenAI dashboard.
OPENAI_API_KEY=sk-...

# Model for translation and shorten-to-fit. Defaults to gpt-4o.
# The deployed Render instance uses gpt-5-mini (see render.yaml).
KARTOUCHE_OPENAI_MODEL=gpt-4o

# Per-request timeout (seconds) and automatic retries for OpenAI calls.
# OPENAI_TIMEOUT_SECONDS=90
# OPENAI_MAX_RETRIES=3

# How many paragraphs are translated in parallel.
# TRANSLATE_CONCURRENCY=4

# --- Access -------------------------------------------------------------------

# Private mode (default): if set, every request needs HTTP Basic Auth
# (any username, this password). Ignored when PUBLIC_DEMO=true.
SITE_PASSWORD=

# Public demo mode: no password, but the limits below are switched on.
PUBLIC_DEMO=false

# --- Limits ---------------------------------------------------------------------
# Values shown are the PUBLIC_DEMO=true defaults. In private mode they default to
# 0 (no limit). Uncomment a line to override it in either mode.

# Documents a single visitor (IP address) can upload per rolling hour.
# RATE_LIMIT_JOBS_PER_HOUR=3
# Sample-lesson runs per visitor per hour (cheap once cached, but uses CPU).
# RATE_LIMIT_SAMPLES_PER_HOUR=20
# Largest document accepted, in words to translate.
# MAX_WORDS_PER_JOB=2500
# Total OpenAI spend allowed per UTC day, in US dollars. When reached,
# uploads pause with a friendly message; the cached sample still works.
# DAILY_SPEND_CAP_USD=2
# Jobs allowed to run at the same time.
# MAX_CONCURRENT_JOBS=2

# --- Files ----------------------------------------------------------------------

# Largest upload accepted, in MB (default 50).
# MAX_UPLOAD_MB=50
# Uploaded files and results are deleted after this many hours (default 24).
# JOB_TTL_HOURS=24
# Where jobs and app state are stored (default: ./webapp_jobs).
# KARTOUCHE_DATA_DIR=
# Number of reverse proxies in front of the app, used to find the visitor's
# real IP for rate limiting (default 1, right for Render).
# PROXY_COUNT=1
